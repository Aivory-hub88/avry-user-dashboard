# ============================================================================
# Supabase Auth (centralized across the whole platform)
# ============================================================================
# All frontends authenticate via Supabase. The browser persists the session in
# localStorage and sends the access token as a Bearer token to the services.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# Microservice URLs
# ============================================================================
# Shared fallback base URL used when a specific service URL is not set.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081

# Per-service base URLs (no trailing slash). In production each service has its
# own domain. When unset, they fall back to NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8081
NEXT_PUBLIC_DIAGNOSTICS_URL=http://localhost:8084
NEXT_PUBLIC_BLUEPRINT_URL=http://localhost:8085
NEXT_PUBLIC_WORKFLOWS_URL=http://localhost:8082
NEXT_PUBLIC_PAYMENTS_URL=http://localhost:3030
NEXT_PUBLIC_ROADMAP_URL=http://localhost:8088

# Public Slack App ID (not a secret) — powers the "open chat" QR shown after a workspace
# install completes. Get it from the Slack app's Basic Information page.
NEXT_PUBLIC_SLACK_APP_ID=

# ============================================================================
# Midtrans Configuration
# ============================================================================
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-<your-client-key>
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ============================================================================
# App Configuration
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:9000

# Console App URL (nextjs-console app)
NEXT_PUBLIC_CONSOLE_URL=http://localhost:9001

# ====================================================================
# VPS Bridge — primary AI gateway (deep diagnostic, workflow copilot,
# console stream). Points at the EXISTING bridge on the VPS; the
# dashboard's thin proxy routes (app/api/*) forward to it.
# Server-side only (never exposed to the browser).
# ====================================================================
VPS_BRIDGE_URL=https://api.aivory.id

# ====================================================================
# Dashboard's own storage (Postgres `dashboard` schema — lib/db.ts,
# lib/serverAuth.ts). Server-side only.
# ====================================================================
DATABASE_URL=
JWT_SECRET=

# 64 hex chars (32 bytes) — encrypts n8n API keys at rest in
# dashboard.n8n_credentials (lib/crypto.ts). Own key, deliberately not
# shared with any other service's ENCRYPTION_KEY.
N8N_CREDENTIALS_ENCRYPTION_KEY=

# --- CRM WhatsApp via Kapso (Aivory-owned number) ---
# Real values live only on the server. Leave unset to disable the Aivory number;
# customers can still connect their own Kapso number from the CRM's WhatsApp panel.
# KAPSO_API_KEY=
# KAPSO_PHONE_NUMBER_ID=
# KAPSO_WEBHOOK_SECRET=        # random string; also passed to scripts/kapso-register-webhook.sh
# KAPSO_CRM_TENANT_ID=         # user_id of the account whose CRM receives the Aivory number
# KAPSO_DISPLAY_PHONE=         # optional, shown in the CRM, e.g. +62 812 3456 7890
# WHATSAPP_WEBHOOK_BASE=       # optional public base incl. /dashboard, used when customers connect
